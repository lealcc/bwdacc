{
  "momentos_upscale_source": {
    "class_type": "MomentosUpscaleSource",
    "inputs": {
      "video": "Momentos/source.mp4",
      "width": 1344,
      "height": 768
    }
  },
  "model": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device": "default"
    }
  },
  "video_vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_video_vae_fp16.safetensors"
    }
  },
  "audio_vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
    }
  },
  "adapter": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": [
        "turbo",
        0
      ],
      "lora_name": "h3/upscale/minimax_h3_open_regenerate_2k_refiner_rank_16_bf16.safetensors",
      "strength_model": 1.0
    },
    "_meta": {
      "momentos_structural_lora": true
    }
  },
  "prompt": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "clip",
        0
      ],
      "text": "Preserve the source subjects, composition, motion and lighting. Refine natural detail."
    }
  },
  "encode": {
    "class_type": "VAEEncodeTiled",
    "inputs": {
      "pixels": [
        "momentos_upscale_source",
        0
      ],
      "vae": [
        "video_vae",
        0
      ],
      "tile_size": 512,
      "overlap": 64,
      "temporal_size": 64,
      "temporal_overlap": 8
    }
  },
  "upscale": {
    "class_type": "MinimaxH3LatentUpscaler3D",
    "inputs": {
      "latent": [
        "encode",
        0
      ],
      "model_name": "minimax_h3_latent_upscaler_3d_fp16.safetensors",
      "mode": "target dimensions",
      "align": 32,
      "keep_proportion": false,
      "device": "cuda",
      "precision": "fp16",
      "offload_after_upscale": true,
      "mode.width": 2560,
      "mode.height": 1440
    }
  },
  "av": {
    "class_type": "MomentosUpscaleAV",
    "inputs": {
      "latent": [
        "upscale",
        0
      ],
      "audio_vae": [
        "audio_vae",
        0
      ]
    }
  },
  "sigma": {
    "class_type": "ManualSigmas",
    "inputs": {
      "sigmas": "0.909375, 0.8571428571428571, 0.6666666666666666, 0"
    }
  },
  "noise": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 1766580932
    }
  },
  "sampler": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "euler"
    }
  },
  "guide": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": [
        "sparse",
        0
      ],
      "conditioning": [
        "prompt",
        0
      ]
    }
  },
  "sample": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": [
        "noise",
        0
      ],
      "guider": [
        "guide",
        0
      ],
      "sampler": [
        "sampler",
        0
      ],
      "sigmas": [
        "sigma",
        0
      ],
      "latent_image": [
        "av",
        0
      ]
    }
  },
  "decode": {
    "class_type": "VAEDecodeTiled",
    "inputs": {
      "samples": [
        "sample",
        0
      ],
      "vae": [
        "decode_vae",
        0
      ],
      "tile_size": 512,
      "overlap": 64,
      "temporal_size": 64,
      "temporal_overlap": 8
    }
  },
  "finish": {
    "class_type": "MomentosUpscaleFinish",
    "inputs": {
      "images": [
        "decode",
        0
      ],
      "video": "Momentos/source.mp4",
      "frame_count": [
        "momentos_upscale_source",
        1
      ],
      "width": 2560,
      "height": 1440
    }
  },
  "save": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "finish",
        0
      ],
      "filename_prefix": "Momentos/Upscale/OpenH3Compact",
      "format": "mp4",
      "format.codec": "h264"
    }
  },
  "turbo": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": [
        "model",
        0
      ],
      "lora_name": "minimax_h3_fl2v_lightx2v_turbo_8step_v1.0_resized_avg_rank_24_bf16.safetensors",
      "strength_model": 1.0
    },
    "_meta": {
      "momentos_structural_lora": true
    }
  },
  "sparse": {
    "class_type": "BlockSparseAttention",
    "inputs": {
      "model": [
        "adapter",
        0
      ],
      "selection": "sol-attn",
      "selection.tau": 1.2,
      "start_percent": 0.0,
      "end_percent": 0.9,
      "dense_blocks": "0,1,49",
      "min_tokens": 12288,
      "extra_tokens": 256,
      "sink_conditioning": "exact_kv_and_rows",
      "verbose": false
    }
  },
  "decode_vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_video_vae_int8_convrot.safetensors"
    }
  }
}
